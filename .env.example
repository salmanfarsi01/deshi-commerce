# ===================================================================
# DESHI COMMERCE — ENVIRONMENT CONFIGURATION
# ===================================================================

# -------------------------------------------------------------------
# Option A: Local Docker PostgreSQL (Used by docker-compose.yml)
# -------------------------------------------------------------------
POSTGRES_DB=deshi_commerce_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Admin@123
POSTGRES_PORT=5432

# pgAdmin Web Interface (http://localhost:5050)
PGADMIN_EMAIL=admin@deshicommerce.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# -------------------------------------------------------------------
# Option B: Cloud Database (Neon / Supabase / AWS RDS / Render)
# If using a managed cloud database without Docker, set these in your
# environment or create an application-local.properties file:
# -------------------------------------------------------------------
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-example.ap-southeast-1.aws.neon.tech/deshi_commerce_db?sslmode=require
# SPRING_DATASOURCE_USERNAME=deshi_user
# SPRING_DATASOURCE_PASSWORD=your_secure_cloud_password

# -------------------------------------------------------------------
# JWT Security
# -------------------------------------------------------------------
JWT_SECRET=DeshiCommerceSecretKeyForJwtSigningMustBeAtLeast256BitsLongForHMACSHA256
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# -------------------------------------------------------------------
# Payment Gateways (Sandbox / Live)
# -------------------------------------------------------------------
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_IS_SANDBOX=true

# -------------------------------------------------------------------
# SMS & Notifications
# -------------------------------------------------------------------
SMS_ENABLED=true
SMS_PROVIDER=sandbox
SMS_SENDER_ID=DESHI_COMM
SMS_API_TOKEN=sandbox-sms-token
